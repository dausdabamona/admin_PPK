  "validationRules": {
    "anggaran.nilaiDibayar": {
      "rule": "must_equal",
      "formula": "nilaiKontrak - (pph21 + pph22 + pph23 + ppn)",
      "description": "Nilai dibayar harus sama dengan nilai kontrak dikurangi total potongan"
    },
    "anggaran.nilaiKontrak": {
      "rule": "must_not_exceed",
      "field": "anggaran.pagu",
      "description": "Nilai kontrak tidak boleh melebihi pagu anggaran"
    },
    "kegiatan.waktu.selesai": {
      "rule": "must_be_after",
      "field": "kegiatan.waktu.mulai",
      "description": "Tanggal selesai harus setelah tanggal mulai"
    },
    "dokumen.bast.tanggal": {
      "rule": "must_be_after_or_equal",
      "field": "kegiatan.waktu.selesai",
      "description": "Tanggal BAST harus setelah atau sama dengan tanggal selesai kegiatan"
    },
    "dokumen.spr.tanggal": {
      "rule": "must_be_after_or_equal",
      "field": "dokumen.bast.tanggal",
      "description": "Tanggal SPR harus setelah atau sama dengan tanggal BAST"
    }
  },

